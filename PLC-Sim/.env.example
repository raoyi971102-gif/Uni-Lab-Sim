# 这些变量由 shell/系统环境读取；程序不会自动加载本文件。

# 可选：替换仓库内 data/demo_variables.csv
PLCSIM_CSV=C:\path\to\your_variables.csv

# 可选：Server 与 GUI 共享的客户端连接状态；两者必须指向同一路径
PLCSIM_CONNECTION_STATE=C:\path\to\runtime\server-connections.json

# 以下仅在使用 InoProShop MCP 功能时需要
PLCSIM_MCP_BUNDLE=C:\path\to\bundle.min.js
PLCSIM_INOPROSHOP_EXE=C:\Program Files\Inovance Control\InoProShop\CODESYS\Common\InoProShop.exe
PLCSIM_INOPROSHOP_PROFILE=InoProShop(V1.9.1.6)
PLCSIM_MCP_WORKSPACE=C:\path\to\workspace
PLCSIM_NODE=node

# 可选：指定自定义 MCP JSON；默认也会检查 ~/.cursor/mcp.json 和 ~/.mcp.json
PLCSIM_MCP_CONFIG=C:\path\to\mcp.json
